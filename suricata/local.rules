# Reglas locales de la actividad 2 (HOME_NET = red corporativa, EXTERNAL_NET = !HOME_NET)
# 1. Escaneo de puertos: muchos SYN desde una misma IP externa en poco tiempo
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL SCAN posible escaneo de puertos TCP SYN"; flow:stateless; flags:S,12; threshold:type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)
# 2. Conexion entrante a servicios internos no publicados (BD, SMB, RDP)
alert tcp $EXTERNAL_NET any -> $HOME_NET [3306,445,3389] (msg:"LOCAL POLICY conexion externa a servicio interno"; flow:to_server; flags:S; classtype:policy-violation; sid:1000002; rev:1;)
# 3. SSH: fuerza bruta (muchas conexiones nuevas al 22 desde la misma IP)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"LOCAL SSH posible fuerza bruta"; flow:to_server; flags:S; threshold:type threshold, track by_src, count 10, seconds 60; classtype:attempted-admin; sid:1000003; rev:1;)
# 4. Intento de inyeccion SQL en el formulario de login
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL WEB intento de inyeccion SQL en login"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/login"; http.request_body; pcre:"/(%27|')\s*(or|and)\s/i"; classtype:web-application-attack; sid:1000004; rev:1;)
# 5. SMTP saliente desde un equipo que no es el servidor de correo
alert tcp $HOME_NET any -> $EXTERNAL_NET 25 (msg:"LOCAL SMTP saliente desde host no autorizado"; flow:to_server; flags:S; classtype:policy-violation; sid:1000005; rev:1;)
